FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS builder
ARG NEXT_PUBLIC_PRIVY_APP_ID
ARG NEXT_PUBLIC_CLOAK_PROGRAM_ID
ARG NEXT_PUBLIC_CLOAK_RELAYER_URL
ARG NEXT_PUBLIC_HELIUS_RPC_URL
ARG NEXT_PUBLIC_IQ_BACKEND_HOST
ARG NEXT_PUBLIC_NOTI_WS_URL
ARG NEXT_PUBLIC_PROGRAM_ID
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SOLANA_CLUSTER
ARG NEXT_PUBLIC_SOLANA_NETWORK
ENV NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID \
    NEXT_PUBLIC_CLOAK_PROGRAM_ID=$NEXT_PUBLIC_CLOAK_PROGRAM_ID \
    NEXT_PUBLIC_CLOAK_RELAYER_URL=$NEXT_PUBLIC_CLOAK_RELAYER_URL \
    NEXT_PUBLIC_HELIUS_RPC_URL=$NEXT_PUBLIC_HELIUS_RPC_URL \
    NEXT_PUBLIC_IQ_BACKEND_HOST=$NEXT_PUBLIC_IQ_BACKEND_HOST \
    NEXT_PUBLIC_NOTI_WS_URL=$NEXT_PUBLIC_NOTI_WS_URL \
    NEXT_PUBLIC_PROGRAM_ID=$NEXT_PUBLIC_PROGRAM_ID \
    NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SOLANA_CLUSTER=$NEXT_PUBLIC_SOLANA_CLUSTER \
    NEXT_PUBLIC_SOLANA_NETWORK=$NEXT_PUBLIC_SOLANA_NETWORK
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3005
ENV PORT=3005
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
