# SolChat Web - Environment Variables
# Copy this file to .env.local and fill in your values

# IQ Protocol Backend
# The backend service for managing on-chain message storage
NEXT_PUBLIC_IQ_BACKEND_HOST=https://iq-testbackend-381334931214.asia-northeast3.run.app

# Solana RPC Endpoint
# Get your free API key from https://helius.dev or https://quicknode.com
# For development, you can use public endpoints (slower and rate-limited)
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# Solana Network
# Options: devnet, testnet, mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Privy Configuration
# Get your App ID and Client ID from https://dashboard.privy.io
# Used for secure embedded wallet management (app wallet)
NEXT_PUBLIC_PRIVY_APP_ID=YOUR_PRIVY_APP_ID_HERE
NEXT_PUBLIC_PRIVY_CLIENT_ID=YOUR_PRIVY_CLIENT_ID_HERE

# Optional: Custom RPC endpoints for different networks
# NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE
# NEXT_PUBLIC_TESTNET_RPC_URL=https://testnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# Optional: Analytics and monitoring (uncomment to use)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_ID=
